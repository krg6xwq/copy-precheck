# Copy this file to .env.local and fill it in. .env.local is ignored by git:
# never commit a real key.

# Needed for the AI checks. Create a project-only key with a spend limit at
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Defaults: claude-sonnet-5-5 at low effort (see decisions in README).
# AI_MODEL=claude-sonnet-5-5
# AI_EFFORT=low
